# GoodAI Monitor Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server Configuration
PORT=8090
HOST=0.0.0.0
LOG_LEVEL=info
TZ=Pacific/Auckland

# Probing & Metrics Collection Intervals
METRICS_INTERVAL=15s
PROBE_INTERVAL=30s
PROBE_TIMEOUT=5s

# Docker Monitoring
DOCKER_SOCKET_PATH=/var/run/docker.sock
MONITORED_CONTAINERS=caddy,grocery-server,alist,alist-bridge

# Synthetic Health Check Targets (comma-separated URLs)
SYNTHETIC_TARGETS=https://price.goodai.co.nz,http://127.0.0.1:8088/api/grocery/status,http://127.0.0.1:5244/api/public/settings,http://127.0.0.1:5245/

# Business Pipeline Watchdog Configuration
PIPELINE_STATUS_URL=http://127.0.0.1:8088/api/grocery/fresh/pipeline/status
PIPELINE_LOG_PATH=/opt/family-hub-vps/grocery_data/morning_pipeline.log
PIPELINE_DEADLINE_TIME=08:30

# Storage & Retention
STORAGE_PATH=./data/monitor.db
DATA_RETENTION_DAYS=14

# Web Dashboard Authentication (Optional: set to false for open internal access)
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=replace_with_a_secure_password

# Alerting Thresholds
RAM_ALERT_THRESHOLD_PERCENT=85
SWAP_ALERT_THRESHOLD_PERCENT=80
DISK_ALERT_THRESHOLD_PERCENT=90
PROBE_FAILURE_THRESHOLD=3
ALERT_COOLDOWN_MINUTES=30

# Notification Webhooks (leave empty to disable specific channels)
ALERT_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# SMTP Email Alerting Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@goodai.co.nz
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM=GoodAI Monitor <alerts@goodai.co.nz>

# Google Account Single Sign-On (OAuth 2.0 / OpenID Connect)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origin: https://goodai.co.nz
# Authorized redirect URI: https://goodai.co.nz/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://goodai.co.nz/api/v1/auth/google/callback

# GitHub Deployment (Used by deploy scripts to pull releases)
GITHUB_REPO=Zachary-du/goodai-monitor
GITHUB_TOKEN=

